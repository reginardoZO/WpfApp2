<UserControl x:Class="WpfApp2.ED8.edSpec"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2.ED8"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <ComboBox x:Name="cmbMotorPower" HorizontalAlignment="Left" Margin="48,46,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="48,20,0,0" TextWrapping="Wrap" Text="Motor Power" VerticalAlignment="Top"/>
        <Button x:Name="btnFindCable" Content="Find" HorizontalAlignment="Left" Margin="194,46,0,0" VerticalAlignment="Top" Width="59" FontSize="10" Height="25" Click="btnFindCable_Click"/>
        <TextBox
    Name="txtMultiline"
    AcceptsReturn="True"
    TextWrapping="Wrap"
    VerticalScrollBarVisibility="Auto"
    Width="300" Margin="48,92,0,0" Height="162" VerticalAlignment="Top" HorizontalAlignment="Left"
/>
        <Button x:Name="btnClipboard" Content="Copy" HorizontalAlignment="Left" Margin="287,268,0,0" VerticalAlignment="Top" FontSize="10" Height="24" Width="61" Click="btnClipboard_Click_1"/>
        <materialDesign:Snackbar x:Name="MySnackbar"
                      VerticalAlignment="Top"
                      Margin="0,883,0,0"
                      Background="#4CAF50" 
         Foreground="White"
                      MessageQueue="{materialDesign:MessageQueue}">
            <materialDesign:Snackbar.Message>
                <materialDesign:SnackbarMessage>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle"
                                      Width="24"
                                      Height="24"
                                      Foreground="White"
                                      Margin="0,0,8,0"/>
                        <TextBlock Text="Operação realizada com sucesso!" 
                        VerticalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:SnackbarMessage>
            </materialDesign:Snackbar.Message>
        </materialDesign:Snackbar>
    </Grid>
</UserControl>
