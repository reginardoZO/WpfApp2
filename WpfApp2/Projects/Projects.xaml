<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2.Projects"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="WpfApp2.Projects.Projects"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <TabControl>
            <TabItem Header="Projects">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Left" Margin="32,22,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Registed" Height="16" Width="65"/>
                    <DataGrid x:Name="gridProjetos" Style="{DynamicResource MaterialDesignDataGrid}" Margin="25,45,0,0" RenderTransformOrigin="0.5,0.5" SelectionChanged="ProjectsDataGrid_SelectionChanged" HorizontalAlignment="Left" Width="234" Height="320" VerticalAlignment="Top" CanUserAddRows="False">
                        <DataGrid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleX="-0.229" AngleY="-0.006"/>
                                <RotateTransform/>
                                <TranslateTransform X="-0.472" Y="-0.008"/>
                            </TransformGroup>
                        </DataGrid.RenderTransform>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Left" Margin="283,25,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Plant" RenderTransformOrigin="-0.356,0.442" Height="16" Width="27"/>
                    <DataGrid x:Name="gridPlants" Style="{DynamicResource MaterialDesignDataGrid}"  Margin="274,45,0,0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="245" Height="320" VerticalAlignment="Top" CanUserAddRows="False">
                        <DataGrid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleX="-0.229" AngleY="-0.024"/>
                                <RotateTransform/>
                                <TranslateTransform X="-0.472" Y="-0.037"/>
                            </TransformGroup>
                        </DataGrid.RenderTransform>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Left" Margin="539,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Register Project" RenderTransformOrigin="-0.356,0.442" Height="16" Width="136">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-0.126"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Left" Margin="540,73,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Code" RenderTransformOrigin="-0.356,0.442" Height="16" Width="49"/>
                    <TextBlock HorizontalAlignment="Left" Margin="541,210,0,176" TextWrapping="Wrap" Text="Plant" RenderTransformOrigin="-0.356,0.442" Width="49"/>
                    <ComboBox x:Name="cmbProject"
          IsEditable="True"
          IsTextSearchEnabled="False"
            PreviewKeyUp="cmbProject_PreviewKeyUp"
          StaysOpenOnEdit="True"
          Margin="612,61,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="136" >

                    </ComboBox>

                    <ComboBox x:Name="cmbPlant"
          IsEditable="True"
          IsTextSearchEnabled="False"
            PreviewKeyUp="cmbPlant_PreviewKeyUp"
          StaysOpenOnEdit="True"
          Margin="613,208,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="136" />
                    <Button Content="Save" HorizontalAlignment="Left" Margin="695,150,0,0" VerticalAlignment="Top" Height="24" FontSize="10" Click="Button_Click" RenderTransformOrigin="1.043,0.598" Width="53"/>
                    <TextBlock HorizontalAlignment="Left" Margin="540,107,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Name" RenderTransformOrigin="-0.356,0.442" Height="16" Width="53"/>
                    <ComboBox x:Name="cmbName" HorizontalAlignment="Left" Margin="611,103,0,0" VerticalAlignment="Top"  IsEditable="True"  StaysOpenOnEdit="True"  Width="138" PreviewKeyUp="cmbName_PreviewKeyUp" Height="24"/>
                    <TextBlock x:Name="txtSelectedProject" Margin="171,25,0,0" TextWrapping="Wrap" Text="-" VerticalAlignment="Top" HorizontalAlignment="Left" TextAlignment="Right" Height="16" Width="88"/>
                    <TextBlock HorizontalAlignment="Left" Margin="540,177,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Text="Register Plant" RenderTransformOrigin="-0.356,0.442" Height="16" Width="136">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="-0.126"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Button x:Name="btnSavePlant" Content="Save" HorizontalAlignment="Left" Margin="695,251,0,0" VerticalAlignment="Top" Height="24" FontSize="10" Click="Save_PlanT" RenderTransformOrigin="1.043,0.598" Width="53"/>



                </Grid>
            </TabItem>
            <TabItem Header="TabItem">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="TabItem">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
        </TabControl>


        <ProgressBar x:Name="LoadingIndicator"
              IsIndeterminate="True"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="100"
              Height="20"
              Visibility="Collapsed"
              Panel.ZIndex="10"/>

    </Grid>
</UserControl>
