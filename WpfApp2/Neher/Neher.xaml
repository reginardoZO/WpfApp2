<UserControl x:Class="WpfApp2.Neher.Neher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2.Neher"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Label Content="Level" HorizontalAlignment="Left" Margin="28,30,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="comboLevel" HorizontalAlignment="Left" Margin="68,30,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="comboLevel_SelectionChanged">
            <ComboBoxItem/>
        </ComboBox>
        <Label Content="Cable" HorizontalAlignment="Left" Margin="25,68,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbCable" HorizontalAlignment="Left" Margin="68,67,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cmbCable_SelectionChanged"/>
        <TextBox x:Name="txttrash" HorizontalAlignment="Left" Margin="317,42,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Conduit" HorizontalAlignment="Left" Margin="20,109,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbConduit" HorizontalAlignment="Left" Margin="103,109,0,0" VerticalAlignment="Top" Width="85" SelectionChanged="cmbConduit_SelectionChanged"/>
        <Label Content="h" HorizontalAlignment="Left" Margin="98,201,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,3.51"/>
        <TextBox x:Name="txtPs" HorizontalAlignment="Left" Margin="137,158,0,0" TextWrapping="Wrap" Text="200" VerticalAlignment="Top" Width="42"/>
        <Label Content="ºC.m/W" HorizontalAlignment="Left" Margin="193,159,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.552,0.554"/>
        <Label Content="ρs" HorizontalAlignment="Left" Margin="103,158,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,3.51"/>
        <TextBox x:Name="txtProf" HorizontalAlignment="Left" Margin="137,200,0,0" TextWrapping="Wrap" Text="2" VerticalAlignment="Top" Width="33"/>
        <Label Content="m" HorizontalAlignment="Left" Margin="193,201,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.552,0.554"/>
        <Label Content="Dist. Center/Center" HorizontalAlignment="Left" Margin="10,244,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,3.51"/>
        <TextBox x:Name="txtDistCenterCenter" HorizontalAlignment="Left" Margin="137,243,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="42"/>
        <Label x:Name="txtQtEletrodutos" Content="Qt. Cond." HorizontalAlignment="Left" Margin="55,286,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,3.51"/>
        <TextBox x:Name="txtqtCond" HorizontalAlignment="Left" Margin="137,285,0,0" TextWrapping="Wrap" Text="4" VerticalAlignment="Top" Width="42"/>
        <Label x:Name="txtQtEletrodutos_Copy" Content="Position" HorizontalAlignment="Left" Margin="59,326,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,3.51"/>
        <TextBox x:Name="txtPosition" HorizontalAlignment="Left" Margin="137,325,0,0" TextWrapping="Wrap" Text="2" VerticalAlignment="Top" Width="42"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="229,368,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Label x:Name="txtQtEletrodutos_Copy1" Content="Amb. Temp." HorizontalAlignment="Left" Margin="59,372,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,3.51"/>
        <TextBox x:Name="txtAmbTemp" HorizontalAlignment="Left" Margin="137,371,0,0" TextWrapping="Wrap" Text="40" VerticalAlignment="Top" Width="42"/>



    </Grid>
</UserControl>
