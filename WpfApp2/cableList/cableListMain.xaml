<UserControl x:Class="WpfApp2.cableList.cableListMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2.cableList"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Canvas Background="#FFF9F9F9" Height="106" VerticalAlignment="Top" HorizontalAlignment="Left" Width="234" Margin="10,10,0,0">
            <Label Content="Project&#xD;&#xA;" Canvas.Left="6" Canvas.Top="15" HorizontalAlignment="Center" VerticalAlignment="Top" Width="53" Height="26" HorizontalContentAlignment="Right"/>
            <Label Content="Plant&#xA;" Canvas.Left="6" Canvas.Top="70" Width="53" Height="26" HorizontalContentAlignment="Right" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Canvas>
        <ComboBox x:Name="cmbProject" HorizontalAlignment="Left" Margin="93,26,0,0" VerticalAlignment="Top" Width="140" SelectionChanged="cmbProject_SelectionChanged"/>
        <ComboBox x:Name="cmbPlant" HorizontalAlignment="Left" Margin="93,78,0,0" VerticalAlignment="Top" Width="140"/>
        <Canvas>
            <Canvas Height="140" Width="792" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="120" Background="#FFFFF9B6" Canvas.Left="10">
                <Label Content="From Type" Canvas.Left="17" Canvas.Top="10"/>
                <Label Content="From Equip" Canvas.Left="23" Canvas.Top="70" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Button x:Name="btnNewEquipFrom" Content="New" Canvas.Left="258" Canvas.Top="66" HorizontalAlignment="Left" VerticalAlignment="Top" Width="61" Click="btnNewEquipFrom_Click"/>
                <Button x:Name="btnNewLocation" Content="New Location" Canvas.Left="348" Canvas.Top="66" Width="140" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnNewLocation_Click"/>
            </Canvas>
            <ComboBox x:Name="cmbFromType" Canvas.Left="115" Canvas.Top="130" Width="120" VerticalAlignment="Top" HorizontalAlignment="Left" SelectionChanged="cmbFromType_SelectionChanged">
                <ComboBoxItem Content="Panel"/>
                <ComboBoxItem Content="Transformer"/>
                <ComboBoxItem Content="VFD"/>
                <ComboBoxItem Content="Soft Starter"/>
                <ComboBoxItem Content="SCR"/>
                <ComboBoxItem Content="CP"/>
                <ComboBoxItem Content="UP"/>
                <ComboBoxItem Content="CCP"/>
                <ComboBoxItem Content="LUP"/>
                <ComboBoxItem Content="LP"/>
                <ComboBoxItem Content="DS"/>



            </ComboBox>
            <ComboBox x:Name="cmbFromEquip" Canvas.Left="115" Canvas.Top="190" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Canvas>
    </Grid>
</UserControl>
