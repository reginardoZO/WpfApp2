<UserControl x:Class="WpfApp2.cableList.addFromVFDSSSCR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2.cableList"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FFE2D8FF">
        <RadioButton Content="VFD" HorizontalAlignment="Left" Margin="18,10,0,0" VerticalAlignment="Top" GroupName="group1"/>
        <RadioButton Content="SCR" HorizontalAlignment="Left" Margin="67,10,0,0" VerticalAlignment="Top" GroupName="group1" Checked="RadioButton_Checked_1"/>
        <RadioButton Content="SOFT STARTER" HorizontalAlignment="Left" Margin="123,10,0,0" GroupName="group1" VerticalAlignment="Top"/>
        <TextBox x:Name="txtTag" HorizontalAlignment="Left" Margin="63,43,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Tag" HorizontalAlignment="Left" Margin="27,43,0,0" VerticalAlignment="Top"/>
        <Label Content="Location" HorizontalAlignment="Left" Margin="4,78,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtLocation" HorizontalAlignment="Left" Margin="63,77,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
    </Grid>
</UserControl>
