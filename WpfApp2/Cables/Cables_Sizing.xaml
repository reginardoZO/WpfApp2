<UserControl x:Class="WpfApp2.Cables.Cables_Sizing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp2.Cables"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Button x:Name="btnSizing" Content="Size" HorizontalAlignment="Left" Margin="395,91,0,0" VerticalAlignment="Top" Click="Button_Click" Height="20" Width="46" FontSize="8"/>
        <TextBlock HorizontalAlignment="Left" Margin="26,50,0,0" TextWrapping="Wrap" Text="Type" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbType" HorizontalAlignment="Left" Margin="68,46,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cmbType_SelectionChanged">

        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="26,91,0,0" TextWrapping="Wrap" Text="Level" VerticalAlignment="Top" RenderTransformOrigin="0.248,3.655"/>
        <ComboBox x:Name="cmbLevel" HorizontalAlignment="Left" Margin="68,86,0,0" VerticalAlignment="Top" Width="120">

        </ComboBox>
        <TextBlock HorizontalAlignment="Left" Margin="207,94,0,0" TextWrapping="Wrap" Text="V" VerticalAlignment="Top"/>
        <TextBlock x:Name="txtLevel" HorizontalAlignment="Left" Margin="239,54,0,0" TextWrapping="Wrap" Text="Power" VerticalAlignment="Top" RenderTransformOrigin="0.248,3.655"/>
        <ComboBox x:Name="cmbUnit" HorizontalAlignment="Left" Margin="377,50,0,0" VerticalAlignment="Top" Width="64"/>
        <TextBlock HorizontalAlignment="Left" Margin="26,132,0,0" TextWrapping="Wrap" Text="Cable" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbCable" HorizontalAlignment="Left" Margin="67,127,0,0" VerticalAlignment="Top" Width="120">

        </ComboBox>

        <RadioButton x:Name="g90"  Content="90ºC" HorizontalAlignment="Left" GroupName="Grupo1" Margin="68,171,0,0" Height="22" VerticalAlignment="Top"/>
        <RadioButton x:Name="g75"  Content="75ºC" GroupName="Grupo1" Margin="134,171,613,0" Height="22" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="13,208,0,0" TextWrapping="Wrap" Text="Correction" VerticalAlignment="Top"/>
        <ComboBox x:Name="cmbCorrection" HorizontalAlignment="Left" Margin="80,200,0,0" VerticalAlignment="Top" Width="108"/>
        <TextBlock x:Name="lblPowerFactor" HorizontalAlignment="Left" Margin="239,94,0,0" TextWrapping="Wrap" Text="Power Factor" VerticalAlignment="Top" RenderTransformOrigin="0.248,3.655"/>
        <TextBox x:Name="txtPowerFactor" HorizontalAlignment="Left" Margin="318,86,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="54" Text="1" TextAlignment="Right"/>
        <TextBox x:Name="txtPower" HorizontalAlignment="Left" Margin="292,50,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="80" TextAlignment="Right"/>
        <RichTextBox x:Name="richText" Margin="13,263,10,10">
            <FlowDocument>
                <Paragraph>
                    <Run Text=""/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>



    </Grid>
</UserControl>
